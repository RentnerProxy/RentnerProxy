{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript"],
    "categories": {
        "correctness": "off",
        "suspicious": "off",
        "perf": "off"
    },
    "rules": {
        "typescript/no-for-in-array": "error",
        "typescript/no-floating-promises": ["error", { "ignoreVoid": false }],
        "typescript/no-misused-promises": "error"
    },
    "overrides": [
        {
            "files": ["web/src/tests/**"],
            "rules": {
                "typescript/no-floating-promises": "error"
            }
        }
    ],
    "options": {
        "typeAware": true
    },
    "ignorePatterns": [
        "**/drizzle/**",
        "**/.env*",
        "**/routeTree.gen.ts",
        "**/*.gen.ts",
        "**/node_modules/**",
        "**/target/**",
        "**/dist/**",
        "**/build/**",
        "**/.git/**",
        "coverage/**",
        "backups/**",
        "tmp/**",
        "temp/**"
    ]
}
